# Copy this file to .env and fill in your keys:   copy .env.example .env   (Windows)

# ------------------------------------------------------------------------------------------
# API keys
# ------------------------------------------------------------------------------------------
# Gemini: https://aistudio.google.com/apikey   (GEMINI_API_KEY also works)
GOOGLE_API_KEY=
# Voyage AI (embeddings + reranking): https://dash.voyageai.com
# IMPORTANT: without a payment method Voyage allows only 3 requests/min and 10K tokens/min, which
# makes ingestion take ~20 min and stalls live questions. Add a card: the voyage-4 / rerank-3
# models include 200M free tokens, so the workshop still costs $0.
VOYAGE_API_KEY=
# LangSmith tracing + evaluation: https://smith.langchain.com  (Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=novel-agent-workshop
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region accounts only

# ------------------------------------------------------------------------------------------
# Gemini models
# ------------------------------------------------------------------------------------------
# Flash-Lite has the most generous free-tier daily quota. With billing enabled, try
# AGENT_MODEL=gemini-3.8-flash for noticeably stronger multi-step reasoning.
AGENT_MODEL=gemini-3.5-flash-lite
ENRICH_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high  (blank = model default; "minimal" is not allowed on gemini-3.8-flash)
AGENT_THINKING_LEVEL=low
ENRICH_THINKING_LEVEL=
# Client-side request throttle per model (free tier is roughly 10-15 RPM). Raise it if you have billing.
GEMINI_RPM=10

# ------------------------------------------------------------------------------------------
# Embeddings & reranking
# ------------------------------------------------------------------------------------------
# voyage (default) | google  (google = gemini-embedding-001 with the same GOOGLE_API_KEY; switching
# provider needs a re-ingest because vectors from different models can't be mixed)
EMBEDDINGS_PROVIDER=voyage
VOYAGE_EMBED_MODEL=voyage-4
GOOGLE_EMBED_MODEL=gemini-embedding-001
RERANK_ENABLED=true
VOYAGE_RERANK_MODEL=rerank-3-lite
# Tokens per embedding request, and an optional requests-per-minute cap (0 = none).
# Voyage free trial without a card (10K tokens/min): EMBED_BATCH_TOKENS=8000 and EMBED_RPM=1
# (~25 min for a whole novel; retries also back off automatically on 429s).
EMBED_BATCH_TOKENS=8000
EMBED_RPM=0

# ------------------------------------------------------------------------------------------
# Ingestion
# ------------------------------------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# Chapters summarized per LLM call during enrichment (8 -> ~8 calls for a 61-chapter novel)
CHAPTERS_PER_CALL=8
# DATA_DIR=./data
