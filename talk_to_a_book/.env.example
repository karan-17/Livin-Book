# Copy to .env (same folder as the notebook) and paste your keys.
# If you skip this file, the notebook will ask for the keys when it starts.

# Gemini: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Voyage AI embeddings: https://dash.voyageai.com  (add a payment method; without one you get only
# 3 requests/minute. The free token allowance still covers this project.)
VOYAGE_API_KEY=
# LangSmith: https://smith.langchain.com  -> Settings -> API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=talk-to-a-book
# EU-region LangSmith accounts only (you get "403 Forbidden" without it):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
